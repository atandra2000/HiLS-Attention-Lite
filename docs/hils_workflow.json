{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "HiLS \u00b7 Training",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "run",
      "label": "Micro-batches"
    },
    {
      "id": "update",
      "label": "Optimizer updates"
    },
    {
      "id": "recovery",
      "label": "Recovery",
      "variant": "exception"
    }
  ],
  "nodes": [
    {
      "id": "phase",
      "lane": "run",
      "col": 0,
      "type": "backend",
      "label": "Limit / phase",
      "sublabel": "A:4K; B:16K",
      "width": 140
    },
    {
      "id": "batch",
      "lane": "run",
      "col": 1,
      "type": "backend",
      "label": "Fetch batch",
      "sublabel": "phase loader",
      "width": 140
    },
    {
      "id": "loss",
      "lane": "run",
      "col": 2,
      "type": "backend",
      "label": "Forward / CE + aux",
      "sublabel": "BF16 on CUDA",
      "width": 140
    },
    {
      "id": "finite",
      "lane": "run",
      "col": 3,
      "type": "security",
      "label": "Finite loss?",
      "sublabel": "before backward",
      "width": 140
    },
    {
      "id": "backward",
      "lane": "run",
      "col": 4,
      "type": "backend",
      "label": "Backward / accum",
      "sublabel": "4 in A; 8 in B",
      "width": 140
    },
    {
      "id": "done",
      "lane": "run",
      "col": 5,
      "type": "backend",
      "label": "Finish",
      "sublabel": "save final if needed",
      "width": 140
    },
    {
      "id": "adam",
      "lane": "update",
      "col": 4,
      "type": "backend",
      "label": "LR / clip / AdamW",
      "sublabel": "update++; save /4000",
      "width": 140
    },
    {
      "id": "watch",
      "lane": "update",
      "col": 5,
      "type": "security",
      "label": "Watchdog",
      "sublabel": ">0.5 for 500 updates",
      "width": 140
    },
    {
      "id": "clear",
      "lane": "recovery",
      "col": 3,
      "type": "backend",
      "label": "Discard gradients",
      "sublabel": "micro=0; bad++",
      "width": 140
    },
    {
      "id": "restore",
      "lane": "recovery",
      "col": 4,
      "type": "backend",
      "label": "Restore latest",
      "sublabel": "model / optim / counters",
      "width": 140
    },
    {
      "id": "abort",
      "lane": "recovery",
      "col": 5,
      "type": "security",
      "label": "Abort",
      "sublabel": "absent or reused checkpoint",
      "width": 140
    }
  ],
  "edges": [
    {
      "id": "phase-batch",
      "from": "phase",
      "to": "batch",
      "label": "below cap",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "batch-loss",
      "from": "batch",
      "to": "loss",
      "label": "",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "loss-finite",
      "from": "loss",
      "to": "finite",
      "label": "",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "finite-backward",
      "from": "finite",
      "to": "backward",
      "label": "yes",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "backward-adam",
      "from": "backward",
      "to": "adam",
      "label": "window full",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "adam-watch",
      "from": "adam",
      "to": "watch",
      "label": "",
      "role": "main",
      "variant": "default"
    },
    {
      "id": "phase-done",
      "from": "phase",
      "to": "done",
      "label": "cap reached",
      "role": "branch",
      "variant": "default"
    },
    {
      "id": "backward-batch",
      "from": "backward",
      "to": "batch",
      "label": "partial window",
      "role": "return",
      "variant": "dashed"
    },
    {
      "id": "watch-phase",
      "from": "watch",
      "to": "phase",
      "label": "below 500",
      "role": "return",
      "variant": "dashed"
    },
    {
      "id": "finite-clear",
      "from": "finite",
      "to": "clear",
      "label": "no",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "clear-batch",
      "from": "clear",
      "to": "batch",
      "label": "bad <5",
      "role": "return",
      "variant": "dashed"
    },
    {
      "id": "clear-restore",
      "from": "clear",
      "to": "restore",
      "label": "bad \u22655",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "watch-restore",
      "from": "watch",
      "to": "restore",
      "label": "500 consecutive",
      "role": "error",
      "variant": "security"
    },
    {
      "id": "restore-phase",
      "from": "restore",
      "to": "phase",
      "label": "restored",
      "role": "return",
      "variant": "dashed"
    },
    {
      "id": "restore-abort",
      "from": "restore",
      "to": "abort",
      "label": "no fresh checkpoint",
      "role": "error",
      "variant": "security"
    }
  ],
  "mainPath": [
    "phase",
    "batch",
    "loss",
    "finite",
    "backward",
    "adam",
    "watch"
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Configured update clock",
      "items": [
        "131,072 positions/update; switch 53,407; cap 61,037.",
        "Epoch / phase boundary drops partial accumulation."
      ]
    },
    {
      "dot": "rose",
      "title": "Guard / persistence limits",
      "items": [
        "Watchdog resets on share \u22640.5; requires 500 consecutive updates.",
        "Bad-loss counter resets on optimizer success, not every finite loss.",
        "Direct writes; no RNG or data cursor; saving precedes watchdog."
      ]
    },
    {
      "dot": "slate",
      "title": "Pinned source",
      "items": [
        "Revision 3dadb375e1e0; configs/pretrain_a100_341m.yaml",
